{
  "rules": [
    {
      "name": "Powers list items",
      "match": {
        "url": "/_api/web/lists/getbytitle('powers')/items",
        "method": "GET"
      },
      "response": {
        "status": 200,
        "headers": {
          "content-type": "application/json"
        },
        "bodyFile": "mocks/list_Powers.json"
      }
    }
  ]
}